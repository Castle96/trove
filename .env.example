# ---------------------------------------------------------------------------
# Trove — unified homelab control plane (PKI / cert lifecycle + monitoring +
# gateway). Copy to .env and adjust. NEVER commit real tokens/secrets.
#
# Prefixes: TROVE_*  -> app/config.py (PKI, gateway, approvals)
#           DOCKWATCH_* -> app/dockwatch/config.py (Docker monitoring, etc.)
# Persisted/UI settings (provider, webhook URLs, notifications, ACME creds)
# are stored in the `settings` table and managed via /api/settings — they can
# also be pre-seeded here through the DB.
# ---------------------------------------------------------------------------

# ------------------------- General / app -------------------------------
# Optional shared bearer token for the API (Authorization: Bearer <key>).
# Empty + no users = open local access.
TROVE_API_KEY=

# Asqlite default. Use postgresql+asyncpg://... for multi-worker setups.
TROVE_DATABASE_URL=sqlite+aiosqlite:///./trove.db

# Where frontend/ + runtime data live (data/, keys/, CA).
TROVE_FRONTEND_DIR=frontend
TROVE_DATA_DIR=./data

# Certificate issuance defaults used by the UI.
TROVE_DEFAULT_VALIDITY_DAYS=90
TROVE_RENEW_WINDOW_DAYS=14

# Default ACME directory / webhook fallbacks until overridden in the UI.
TROVE_ACME_DIRECTORY_URL=https://ca.local.lan:9000/acme/acme/directory
TROVE_WEBHOOK_URL=

# Bootstraps the first admin account if both are set (user auth mode).
TROVE_ADMIN_USERNAME=
TROVE_ADMIN_PASSWORD=

# ------------------------- Key encryption at rest -----------------------
# Master key used to AES-256-GCM encrypt stored private keys (local CA keys +
# private keys captured at issuance). If unset, auto-generated first-run under
# data/keys/master.key (0600). In production set explicitly from a secret
# manager (and back it up!) or the encrypted keys become unrecoverable.
# TROVE_KEY_ENCRYPTION_KEY=

# ------------------------- Background scheduler -------------------------
# Auto-renewal pass interval (seconds) + daily expiry reminders.
TROVE_SCHEDULER_ENABLED=true
TROVE_SCHEDULER_INTERVAL_SECONDS=21600
TROVE_EXPIRY_REMINDER_DAYS=14

# ------------------------- Approval workflow ----------------------------
# true = POST /api/certs creates an IssueRequest pending admin approval.
# TROVE_REQUIRE_APPROVAL=false

# ------------------------- Local-only issuance --------------------------
# true = only the managed local CA may issue: the ACME provider is rejected
# at issuance/renewal and via the settings API, so no certificate can come
# from an external CA (zero-external-issuers invariant). Create a managed CA
# under /api/ca first (root + intermediate, then set it active).
# TROVE_REQUIRE_LOCAL_ISSUANCE=false

# Demo seed data: true populates an empty database with the 5 demo
# certificates from app/seed.py. Off by default so production boot never
# injects external-issuer demo records.
# TROVE_SEED_DEMO_DATA=true

# ------------------------- Optional Vault secrets backend -----------------
# When both are set, secrets (Cloudflare token, SMTP password) are read/written
# through HashiCorp Vault KV v2 instead of the local settings table.
# TROVE_VAULT_ADDR=http://vault:8200
# TROVE_VAULT_TOKEN=
TROVE_VAULT_PATH=trove

# ------------------------- Optional filesystem CA ------------------------
# Takes priority over the managed in-DB CA for CRL/OCSP signing.
# TROVE_CA_CERT_PATH=
# TROVE_CA_KEY_PATH=

# ------------------------- ACME http-01 webroot --------------------------
# Served at /.well-known/acme-challenge when using the ACME provider with the
# http-01 validation method.
# TROVE_ACME_WEBROOT=/var/www/html

# ------------------------- Email notifications ---------------------------
TROVE_NOTIFY_EMAIL_FROM=trove@localhost

# ===========================================================================
# DOCKWATCH_* — monitoring subsystem (app/dockwatch/config.py)
# ===========================================================================

DOCKWATCH_DATABASE_URL=sqlite+aiosqlite:///./dockwatch.db
DOCKWATCH_LOG_LEVEL=INFO

# Host-header validation: set your domain(s), e.g. trove.example.com, or leave
# ["*"] to accept any Host (only safe on a trusted LAN).
DOCKWATCH_ALLOWED_HOSTS=["*"]
# CORS origins permitted to call the API (empty = same-origin only).
# DOCKWATCH_CORS_ORIGINS=["https://app.example.com"]

# Serve the interactive API docs. Disable when auth is on and you don't want
# the surface documented publicly.
DOCKWATCH_ENABLE_OPENAPI=true
# Response hardening headers. Override Content-Security-Policy when needed.
DOCKWATCH_SECURITY_HEADERS=true
# DOCKWATCH_CSP_OVERRIDE=
# Per-request wall-clock budget before the request is aborted with 504.
DOCKWATCH_REQUEST_TIMEOUT=30.0
# Grace period for in-flight background work during shutdown.
DOCKWATCH_SHUTDOWN_GRACE_SECONDS=3.0

# Create missing tables on startup (additive; safe to leave on).
DOCKWATCH_CREATE_ALL_ON_STARTUP=true
# Pool sizing (ignored for SQLite).
DOCKWATCH_DATABASE_POOL_SIZE=5
DOCKWATCH_DATABASE_MAX_OVERFLOW=10

# Docker-API socket: primary + fallbacks (Podman under the hood, so a
# Podman-only host works without config).
DOCKWATCH_DOCKER_HOST=unix:///var/run/docker.sock
# DOCKWATCH_DOCKER_SOCKET_FALLBACKS=["unix:///run/podman/podman.sock"]
DOCKWATCH_DOCKER_TIMEOUT=5.0
DOCKWATCH_MAX_STATS_CONTAINERS=50
DOCKWATCH_LOGS_TAIL=200

# Host-metrics sampler (CPU/mem/disk) persisted to the dockwatch DB.
DOCKWATCH_ENABLE_MONITOR_SAMPLER=true
DOCKWATCH_MONITOR_SAMPLER_INTERVAL=2.0
DOCKWATCH_MONITOR_RETENTION_DAYS=7
DOCKWATCH_MONITOR_ANOMALY_ZSCORE=2.5

# Fleet (remote endpoint) fan-out.
DOCKWATCH_FLEET_POLL_CONCURRENCY=5
DOCKWATCH_FLEET_POLL_TIMEOUT=8.0

# Trivy vulnerability scanning.
DOCKWATCH_TRIVY_BIN=trivy
DOCKWATCH_TRIVY_TIMEOUT=180.0
DOCKWATCH_TRIVY_IMAGE_SRC=docker
DOCKWATCH_TRIVY_CACHE_HOURS=24.0
DOCKWATCH_ENABLE_RESCAN_LOOP=true

# LLM model nodes for the Models view: JSON [{name,url,engine}], engine
# "ollama" | "llamacpp". Empty = nothing exposed.
# DOCKWATCH_MODEL_NODES=[{"name":"local","url":"http://127.0.0.1:11434","engine":"ollama"}]
DOCKWATCH_MODEL_POLL_CONCURRENCY=5
DOCKWATCH_MODEL_POLL_TIMEOUT=5.0

# Voice (Jarvis) pipeline telemetry.
DOCKWATCH_ENABLE_VOICE=true
DOCKWATCH_VOICE_JARVIS_AGENT=true
# Demo turns keep the voice dashboard alive WITHOUT a real audio stack.
# Keep false in production — the real worker reports via /api/voice/ingest.
DOCKWATCH_ENABLE_VOICE_DEMO=false
DOCKWATCH_VOICE_DEMO_INTERVAL=15.0
DOCKWATCH_VOICE_RETENTION_DAYS=30

# Prometheus metrics export at /api/metrics (unauthenticated — restrict at proxy).
DOCKWATCH_ENABLE_METRICS=true

# Dev-pipeline code agents (Fleet-probed model nodes + Pipelines tab). JSON:
# [{name, language, model, engine, endpoint_url}]. language is "rust" | "go" |
# "python"; engine "ollama" | "llamacpp" (default ollama); endpoint_url default
# http://<name>:11434. Each becomes a kind="code" fleet endpoint + swarm agent.
# Servers (simulated) probe/testing assumes Ollama's /api/tags today.
# DOCKWATCH_CODE_AGENTS=[
#   {"name":"ray","language":"rust","model":"qwen2.5-coder:1.5b","engine":"ollama"},
#   {"name":"fleet","language":"go","model":"qwen2.5-coder:1.5b","engine":"ollama"},
#   {"name":"jarvis","language":"python","model":"qwen2.5-coder:1.5b","engine":"ollama"}
# ]

# Anomaly alerting via webhook (ntfy/Slack-compatible/generic HTTP).
DOCKWATCH_ENABLE_ALERTING=true
# DOCKWATCH_ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic
DOCKWATCH_ALERT_WEBHOOK_TIMEOUT=5.0
DOCKWATCH_ALERT_COOLDOWN_SECONDS=300.0

# Container-stats snapshot loop feeding the ranking endpoint.
DOCKWATCH_ENABLE_CONTAINER_STATS=true
DOCKWATCH_CONTAINER_STATS_INTERVAL=60.0
