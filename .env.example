# Trove configuration - copy to .env and fill in
# NEVER commit real tokens/secrets.

# Optional bearer token for the API. Leave empty for open local access.
TROVE_API_KEY=

# SQLite is the zero-config default for a homelab.
TROVE_DATABASE_URL=sqlite+aiosqlite:///./trove.db

TROVE_DEFAULT_VALIDITY_DAYS=90
TROVE_RENEW_WINDOW_DAYS=14

# Defaults used by the UI until overridden from the "Providers & Webhooks" panel.
TROVE_ACME_DIRECTORY_URL=https://ca.local.lan:9000/acme/acme/directory
TROVE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Key encryption at rest
# ---------------------------------------------------------------------------
# Master key used to AES-256-GCM encrypt private keys stored by Trove (local
# CA keys + private keys captured at issuance). If unset, Trove auto-generates
# one on first use and stores it under data/keys/master.key with 0600 perms.
# In production set this explicitly (e.g. from a secret manager).
# TROVE_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Local CA (internal PKI)
# ---------------------------------------------------------------------------
# Optional CA key material used for CRL + OCSP over internally-issued certs.
# The /api/ca endpoints can manage an in-DB CA too; these paths take priority
# when set (the ephemeral CA's key is used to sign CRL/OCSP).
# TROVE_CA_CERT_PATH=
# TROVE_CA_KEY_PATH=

# ---------------------------------------------------------------------------
# Scheduler / notifications
# ---------------------------------------------------------------------------
# Background auto-renewal pass (every N seconds) and daily expiry reminders.
TROVE_SCHEDULER_ENABLED=true
TROVE_SCHEDULER_INTERVAL_SECONDS=21600
# Days before expiry at which a daily "certificate expiring" reminder fires.
TROVE_EXPIRY_REMINDER_DAYS=14

# Require an admin to approve issuance requests (approval workflow):
# TROVE_REQUIRE_APPROVAL=false

# Email notifications default sender.
# TROVE_NOTIFY_EMAIL_FROM=trove@localhost